{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadProductionSecret",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": "arn:aws:secretsmanager:us-east-2:563692880710:secret:better-budget/prod-zALPFC"
        },
        {
            "Sid": "GetEcrAuthorizationToken",
            "Effect": "Allow",
            "Action": "ecr:GetAuthorizationToken",
            "Resource": "*"
        },
        {
            "Sid": "PullRuntimeImages",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:GetDownloadUrlForLayer"
            ],
            "Resource": "arn:aws:ecr:us-east-2:563692880710:repository/better-budget/app"
        },
        {
            "Sid": "ManageProductionLogGroup",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:DescribeLogStreams",
                "logs:PutRetentionPolicy"
            ],
            "Resource": "arn:aws:logs:us-east-2:563692880710:log-group:/better-budget/production"
        },
        {
            "Sid": "WriteProductionLogStreams",
            "Effect": "Allow",
            "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
            "Resource": "arn:aws:logs:us-east-2:563692880710:log-group:/better-budget/production:*"
        }
    ]
}
