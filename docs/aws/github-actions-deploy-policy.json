{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "GetEcrAuthorizationToken",
            "Effect": "Allow",
            "Action": "ecr:GetAuthorizationToken",
            "Resource": "*"
        },
        {
            "Sid": "PushRuntimeImages",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:CompleteLayerUpload",
                "ecr:GetDownloadUrlForLayer",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
            ],
            "Resource": "arn:aws:ecr:us-east-2:563692880710:repository/better-budget/app"
        },
        {
            "Sid": "DiscoverProductionInstance",
            "Effect": "Allow",
            "Action": "ec2:DescribeInstances",
            "Resource": "*"
        },
        {
            "Sid": "UseRunShellScriptDocument",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": "arn:aws:ssm:us-east-2::document/AWS-RunShellScript"
        },
        {
            "Sid": "DeployToTaggedProductionInstance",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": "arn:aws:ec2:us-east-2:563692880710:instance/*",
            "Condition": {
                "StringEquals": {
                    "ssm:resourceTag/Application": "better-budget",
                    "ssm:resourceTag/Environment": "production"
                }
            }
        },
        {
            "Sid": "ReadSystemsManagerCommandStatus",
            "Effect": "Allow",
            "Action": [
                "ssm:DescribeInstanceInformation",
                "ssm:GetCommandInvocation",
                "ssm:ListCommandInvocations"
            ],
            "Resource": "*"
        }
    ]
}
