{
    "name": "better-budget",
    "version": "2.0.2",
    "description": "A calm, shared household budget that keeps every dollar clear.",
    "private": true,
    "packageManager": "npm@11.17.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "dev:mobile": "next dev --hostname 0.0.0.0",
        "dev:postgres": "DATABASE_KIND=postgres next dev",
        "build": "next build --webpack",
        "start": "node scripts/validate-production-environment.mjs && next start",
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate.ts",
        "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts",
        "db:reset": "tsx scripts/reset-local.ts",
        "db:owner": "NODE_OPTIONS=--conditions=react-server BETTER_BUDGET_BOOTSTRAP=true tsx scripts/create-owner.ts"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "1.6.26",
        "@electric-sql/pglite": "0.5.4",
        "@radix-ui/react-dialog": "1.1.23",
        "@radix-ui/react-switch": "1.3.7",
        "@tanstack/react-query": "5.101.4",
        "better-auth": "1.6.26",
        "clsx": "2.1.1",
        "drizzle-orm": "0.45.2",
        "lucide-react": "1.31.0",
        "next": "16.3.0",
        "pg": "8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "0.0.1",
        "tailwind-merge": "3.6.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "26.2.0",
        "@types/pg": "8.21.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.0",
        "prettier": "3.9.6",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.11",
        "typescript": "6.0.3"
    },
    "allowScripts": {
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true
    }
}
