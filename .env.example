DATABASE_KIND=pglite
PGLITE_DATA_DIR=.data/pglite
DATABASE_URL=postgres://better_budget:better_budget@localhost:5432/better_budget
DATABASE_POOL_SIZE=5
DATABASE_SSL=disable
DATABASE_SSL_CA=
MIGRATIONS_PRESTART=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_BYPASS=true
ALLOW_INSECURE_LOCAL_AUTH=false
BOOTSTRAP_OWNER_EMAIL=family@betterbudget.local
BOOTSTRAP_OWNER_PASSWORD=change-me-locally
